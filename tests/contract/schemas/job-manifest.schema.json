{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.transcription/schemas/job-manifest-v2.json",
  "title": "Transcription Job Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "status", "created_at", "updated_at", "source", "transcription", "artifacts", "error"],
  "properties": {
    "schema_version": { "const": 2 },
    "job_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["queued", "running", "completed", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_filename", "artifact", "media_type", "size_bytes", "sha256"],
      "properties": {
        "original_filename": { "type": "string" },
        "artifact": { "const": "source.webm" },
        "media_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "language", "model", "speaker_detection", "timestamps"],
      "properties": {
        "engine": { "const": "noscribe" },
        "language": { "type": "string" },
        "model": { "enum": ["fast", "precise"] },
        "speaker_detection": { "type": "string", "pattern": "^(none|auto|[1-9]|10)$" },
        "timestamps": { "const": true },
        "exit_code": { "type": ["integer", "null"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "source": { "const": "source.webm" },
        "transcript_html": { "const": "transcript.html" }
      }
    },
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
