# Отдельный каталог данных кандидата. Не используйте каталог legacy-приложения.
NEXT_DATA_DIR=./data

# Общая для всех пользователей приложения директория persistent-векторов ZeusDB.
# Она должна оставаться внутри NEXT_DATA_DIR и быть доступна только worker-у приложения.
NEXT_ZEUSDB_DIR=./data/zeusdb

# Для включения ASR оператор доставляет проверенный manifest и FFmpeg локально.
# Не указывайте URL: приложение не скачивает модели во время работы.
NEXT_MODELS_DIR=./data/models
# NEXT_ASR_MANIFEST=asr-pack.json
# NEXT_FFMPEG_PATH=C:\Tools\ffmpeg\bin\ffmpeg.exe

# Кандидатный HTTP-порт. В production включайте HTTPS на reverse proxy.
NEXT_HOST=127.0.0.1
NEXT_PORT=8010
NEXT_INSTANCE_ID=transcription-next-candidate

# При HTTPS установите true. Cookie имеет отдельное имя от legacy.
NEXT_COOKIE_SECURE=false
NEXT_SESSION_TTL_DAYS=14

# Ограничение попыток регистрации и входа для одного IP за минуту.
NEXT_AUTH_RATE_LIMIT=10

# Автоматическое сопоставление голосов выключено, пока оператор не завершит
# калибровку. Пороги distance зависят от конкретного локального voice pack.
NEXT_VOICE_CALIBRATED=false
NEXT_VOICE_AUTO_ASSIGN_ENABLED=false
# NEXT_VOICE_CANDIDATE_MAX_DISTANCE=0.00
# NEXT_VOICE_AUTO_MAX_DISTANCE=0.00
# NEXT_VOICE_MIN_MARGIN=0.00
# NEXT_VOICE_MIN_INTERVALS=2
# NEXT_VOICE_MIN_COVERAGE=0.70
# NEXT_VOICE_MIN_DURATION_MS=1000
# NEXT_VOICE_MIN_QUALITY=0.01
# NEXT_VOICE_MIN_SPEECH_RATIO=0.00
