# Каталог данных сервиса. Относительный путь считается от текущего каталога запуска.
TRANSCRIPTION_DATA_DIR=./data

# Путь к установленному noScribe 0.7+.
TRANSCRIPTION_NOSCRIBE_PATH=C:\Program Files (x86)\noScribe\noScribe.exe

# Значения первой версии: ru, precise, fast.
TRANSCRIPTION_DEFAULT_LANGUAGE=ru
TRANSCRIPTION_DEFAULT_MODEL=precise
TRANSCRIPTION_ALLOWED_MODELS=fast,precise

# 5 GiB и 6 часов по умолчанию.
TRANSCRIPTION_MAX_UPLOAD_BYTES=5368709120
TRANSCRIPTION_NOSCRIBE_TIMEOUT_SECONDS=21600

# Необязательный общий токен. Обязательно задайте его при публикации в локальную сеть.
TRANSCRIPTION_API_TOKEN=
