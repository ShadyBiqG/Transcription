# Постоянные данные: SQLite, исходные записи, HTML и журналы.
# На сервере рекомендуется абсолютный локальный путь, например E:\TranscriptionData.
TRANSCRIPTION_DATA_DIR=./data

# Полный путь к noScribe 0.7+. Программа и модели должны быть установлены на сервере.
TRANSCRIPTION_NOSCRIBE_PATH=C:\Program Files (x86)\noScribe\noScribe.exe

# Язык по умолчанию: auto или 2–8 латинских букв. Пользователь может изменить его в форме.
TRANSCRIPTION_DEFAULT_LANGUAGE=ru

# Выбранная по умолчанию модель обязана входить в список разрешенных моделей.
TRANSCRIPTION_DEFAULT_MODEL=precise

# Разрешенные модели через запятую; они также должны быть установлены в noScribe.
TRANSCRIPTION_ALLOWED_MODELS=fast,precise

# Максимальный размер одного WEBM в байтах. Ниже указано 5 ГиБ.
TRANSCRIPTION_MAX_UPLOAD_BYTES=5368709120

# Максимальное время одного запуска noScribe в секундах. Ниже указано 6 часов.
TRANSCRIPTION_NOSCRIBE_TIMEOUT_SECONDS=21600

# Срок действия новой пользовательской сессии в днях.
TRANSCRIPTION_SESSION_TTL_DAYS=30

# false для прямого HTTP; true только после настройки HTTPS.
TRANSCRIPTION_COOKIE_SECURE=false
